<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-pdal-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>hop-pdal-values</artifactId>
  <dependencies>
    <dependency>
      <groupId>ch.so.agi</groupId>
      <artifactId>hop-pointcloud-core</artifactId>
      <version>${hop.pointcloud.type.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ch.so.agi</groupId>
      <artifactId>hop-pointcloud-type</artifactId>
      <version>${hop.pointcloud.type.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ch.so.agi</groupId>
      <artifactId>pdal-ffm-core</artifactId>
      <version>${pdal-java.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hop</groupId>
      <artifactId>hop-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.hop</groupId>
      <artifactId>hop-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.hop</groupId>
      <artifactId>hop-ui</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- pdal-ffm-core needs native access for the FFM downcalls. -->
          <argLine>${ui.test.argLine} --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>${jandex.plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Platform specific PDAL runtime. The matching classifier JAR is bundled
         into the plugin ZIP so that the plugin works without a system PDAL. -->
    <profile>
      <id>pdal-natives-osx-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.so.agi</groupId>
          <artifactId>pdal-ffm-natives</artifactId>
          <version>${pdal-java.version}</version>
          <classifier>natives-osx-aarch64</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>pdal-natives-osx-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.so.agi</groupId>
          <artifactId>pdal-ffm-natives</artifactId>
          <version>${pdal-java.version}</version>
          <classifier>natives-osx-x86_64</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>pdal-natives-linux-x86_64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.so.agi</groupId>
          <artifactId>pdal-ffm-natives</artifactId>
          <version>${pdal-java.version}</version>
          <classifier>natives-linux-x86_64</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>pdal-natives-linux-aarch64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.so.agi</groupId>
          <artifactId>pdal-ffm-natives</artifactId>
          <version>${pdal-java.version}</version>
          <classifier>natives-linux-aarch64</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>pdal-natives-windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.so.agi</groupId>
          <artifactId>pdal-ffm-natives</artifactId>
          <version>${pdal-java.version}</version>
          <classifier>natives-windows-x86_64</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
