<pipeline>
  <info>
    <name>Crop a point cloud</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_FILE</name>
        <default_value />
        <description>LAS/LAZ, COPC, EPT, BPF or text source</description>
      </parameter>
      <parameter>
        <name>OUTPUT_FILE</name>
        <default_value />
        <description>Cropped output file</description>
      </parameter>
      <parameter>
        <name>MIN_X</name>
        <default_value>2600000</default_value>
      </parameter>
      <parameter>
        <name>MIN_Y</name>
        <default_value>1200000</default_value>
      </parameter>
      <parameter>
        <name>MAX_X</name>
        <default_value>2600500</default_value>
      </parameter>
      <parameter>
        <name>MAX_Y</name>
        <default_value>1200500</default_value>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>One row</from>
      <to>Read point cloud</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read point cloud</from>
      <to>Crop point cloud</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Crop point cloud</from>
      <to>Write point cloud</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>One row</name>
    <type>RowGenerator</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <nullif>1</nullif>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Read point cloud</name>
    <type>SOGIS_POINTCLOUD_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <source>${INPUT_FILE}</source>
    <sourceField>N</sourceField>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Crop point cloud</name>
    <type>SOGIS_POINTCLOUD_CROP</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <outputValueField>cropped</outputValueField>
    <boundsFields>N</boundsFields>
    <minX>${MIN_X}</minX>
    <minY>${MIN_Y}</minY>
    <minZ />
    <maxX>${MAX_X}</maxX>
    <maxY>${MAX_Y}</maxY>
    <maxZ />
    <GUI>
      <xloc>560</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write point cloud</name>
    <type>SOGIS_POINTCLOUD_WRITER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>cropped</valueField>
    <source>${OUTPUT_FILE}</source>
    <sourceField>N</sourceField>
    <overwrite>Y</overwrite>
    <prefix>pointcloud_</prefix>
    <GUI>
      <xloc>780</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>
