<pipeline>
  <info>
    <name>Point cloud metadata</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_FILE</name>
        <default_value />
        <description>LAS/LAZ, COPC, EPT, BPF or text source</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>One row</from>
      <to>Read point cloud</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read point cloud</from>
      <to>Point cloud info</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>One row</name>
    <type>RowGenerator</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <nullif>1</nullif>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Read point cloud</name>
    <type>SOGIS_POINTCLOUD_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <source>${INPUT_FILE}</source>
    <sourceField>N</sourceField>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Point cloud info</name>
    <type>SOGIS_POINTCLOUD_INFO</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <infoFields>point_count,bounds,crs,dimensions</infoFields>
    <prefix>pc_</prefix>
    <GUI>
      <xloc>560</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>
