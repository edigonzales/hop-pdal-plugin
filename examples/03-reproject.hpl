<pipeline>
  <info>
    <name>Reproject a point cloud</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_FILE</name>
        <default_value />
        <description>LAS/LAZ, COPC, EPT, BPF or text source</description>
      </parameter>
      <parameter>
        <name>OUTPUT_FILE</name>
        <default_value />
        <description>Reprojected output file</description>
      </parameter>
      <parameter>
        <name>TARGET_CRS</name>
        <default_value>EPSG:2056</default_value>
        <description>Target CRS (EPSG code or WKT)</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>One row</from>
      <to>Read point cloud</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read point cloud</from>
      <to>Reproject point cloud</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reproject point cloud</from>
      <to>Write point cloud</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>One row</name>
    <type>RowGenerator</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <nullif>1</nullif>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Read point cloud</name>
    <type>SOGIS_POINTCLOUD_READER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <source>${INPUT_FILE}</source>
    <sourceField>N</sourceField>
    <GUI>
      <xloc>340</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Reproject point cloud</name>
    <type>SOGIS_POINTCLOUD_REPROJECT</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>pointcloud</valueField>
    <outputValueField>reprojected</outputValueField>
    <targetCrs>${TARGET_CRS}</targetCrs>
    <targetCrsField>N</targetCrsField>
    <GUI>
      <xloc>560</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Write point cloud</name>
    <type>SOGIS_POINTCLOUD_WRITER</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <version>1</version>
    <valueField>reprojected</valueField>
    <source>${OUTPUT_FILE}</source>
    <sourceField>N</sourceField>
    <overwrite>Y</overwrite>
    <prefix>pointcloud_</prefix>
    <GUI>
      <xloc>780</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>
